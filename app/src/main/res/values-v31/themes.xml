<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A abertura do sistema fica vazia e escura: logo em seguida o Dot da pessoa aparece no meio (WelcomeOverlay). -->
    <style name="Theme.PersonDot" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/persondot_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/persondot_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_dot</item>
    </style>
</resources>
